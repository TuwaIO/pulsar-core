{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Packages",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/*"],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/__tests__/**",
      "**/tests/**",
      "**/setup.ts"
    ],
    "excludeInternal": true,
    "excludeExternals": true,
    "gitRevision": "main",
    "compilerOptions": {
      "paths": {
        "@tuwaio/pulsar-core": ["./packages/pulsar-core/src/index.ts"],
        "@tuwaio/pulsar-evm": ["./packages/pulsar-evm/src/index.ts"],
        "@tuwaio/pulsar-solana": ["./packages/pulsar-solana/src/index.ts"],
        "@tuwaio/pulsar-react": ["./packages/pulsar-react/src/index.ts"]
      }
    }
  },
  "plugin": [
    "typedoc-plugin-markdown",
    "./apps/docs/typedoc/preserveTypeAnnotations.mjs",
    "./apps/docs/typedoc/nextraRoutes.mjs"
  ],
  "out": "apps/docs/src/content/packages",
  "publicPath": "/packages/",
  "readme": "apps/docs/typedoc/packages-overview.md",
  "mergeReadme": true,
  "entryFileName": "index",
  "excludeScopesInPaths": true,
  "pageTitleTemplates": {
    "member": "{name}"
  },
  "githubPages": false,
  "hideGenerator": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "cleanOutputDir": true
}
