{
  "name": "@tuwaio/pulsar-core",
  "version": "0.9.0",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L3 core of Pulsar (TUWA): headless, framework-agnostic transaction store with localStorage persistence, a chain adapter contract, metadata validation and remote sync hooks for tracking EVM and Solana transactions.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "tuwa",
    "pulsar",
    "transaction-tracking",
    "web3",
    "multi-chain",
    "evm",
    "solana",
    "zustand",
    "immer",
    "typescript",
    "framework-agnostic",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/pulsar-core.git",
    "directory": "packages/pulsar-core"
  },
  "homepage": "https://github.com/TuwaIO/pulsar-core",
  "bugs": {
    "url": "https://github.com/TuwaIO/pulsar-core/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/orbit-core": ">=0.4",
    "dayjs": "1.x.x",
    "immer": "11.x.x",
    "zustand": "5.x.x"
  },
  "devDependencies": {
    "@tuwaio/orbit-core": "^0.4.0",
    "dayjs": "^1.11.23",
    "immer": "^11.1.18",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
